# Docker Compose local defaults. Replace credentials before deployment.
POSTGRES_PASSWORD=123456
POSTGRES_USER=postgres
POSTGRES_DB=QuanLyCLBDB
# POSTGRES_PASSWORD and DATABASE_URL must use the same PostgreSQL role password.
# URL-encode reserved characters in the password inside DATABASE_URL.
DATABASE_URL=postgresql://postgres:123456@localhost:5432/QuanLyCLBDB?options=-c%20search_path%3Ddbo
JWT_SECRET=local-development-secret-change-before-deploying
MINIO_ROOT_USER=med09minio
MINIO_ROOT_PASSWORD=local-minio-password-change-before-deploying
STORAGE_ENABLED=true
