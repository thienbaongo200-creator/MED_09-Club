PORT=3001
# Enable only when MinIO at S3_ENDPOINT is running.
STORAGE_ENABLED=false
# Set the same real PostgreSQL role password as POSTGRES_PASSWORD in the root .env.
# URL-encode reserved characters in the password in this URL.
DATABASE_URL=postgresql://postgres:123456@localhost:5432/QuanLyCLBDB?options=-c%20search_path%3Ddbo
JWT_SECRET=local-development-secret-change-before-deploying
JWT_EXPIRES_IN=15m
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=med09-vouchers
S3_ACCESS_KEY=med09minio
S3_SECRET_KEY=local-minio-password-change-before-deploying
S3_FORCE_PATH_STYLE=true
FRONTEND_ORIGIN=http://localhost:3000
