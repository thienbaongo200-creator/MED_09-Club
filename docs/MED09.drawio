                <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\n\nactor \&quot;Người dùng\&quot; as User\nparticipant \&quot;FundPage\&quot; as FundPage\nparticipant \&quot;RolesGuard\&quot; as RolesGuard\nparticipant \&quot;FundsController\&quot; as FundsController\nparticipant \&quot;FundsService\&quot; as FundsService\nparticipant \&quot;SearchService\&quot; as SearchService\nparticipant \&quot;MaskingPolicy\&quot; as MaskingPolicy\nparticipant \&quot;PostgreSQL\&quot; as PostgreSQL\n\nUser -&gt; FundPage: Mở sao kê, nhập bộ lọc hoặc từ khóa\nFundPage -&gt; RolesGuard: GET /api/fund/transactions\\n(JWT)\nRolesGuard -&gt; FundsController: Cho phép cả ba vai trò\nFundsController -&gt; FundsService: getStatement(filter,\\nkeyword)\n\nalt có từ khóa\n    FundsService -&gt; SearchService: buildPredicate(keyword)\n    SearchService --&gt; FundsService: điều kiện SQL (nội dung\\nđược che PII trước khi so\\nkhớp)\nend\n\nFundsService -&gt; PostgreSQL: SELECT giao_dich_quy JOIN thanh_vien (kèm điều kiện lọc và tìm kiếm)\nPostgreSQL --&gt; FundsService: giao dịch kèm họ tên, email, số điện thoại gốc\nFundsService -&gt; MaskingPolicy: maskPhone, maskEmail, maskFreeText\nMaskingPolicy --&gt; FundsService: dữ liệu đã che\nFundsService --&gt; FundPage: PublicStatementDto (dữ liệu gốc không rời Service)\n\nFundPage -&gt; RolesGuard: GET /api/fund/summary\\n(JWT)\nRolesGuard -&gt; FundsController: Chuyển yêu cầu\nFundsController -&gt; FundsService: getSummary()\nFundsService -&gt; PostgreSQL: SELECT SUM(THU) - SUM(CHI) trên toàn quỹ\nPostgreSQL --&gt; FundsService: số dư\nFundsService --&gt; FundPage: Số dư toàn quỹ\nFundPage --&gt; User: Hiển thị sao kê và số dư\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="wLvlozRV8pZMNazjZht--50">
                    <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
                        <mxGeometry as="geometry"/>
                    </mxCell>
                </UserObject>
