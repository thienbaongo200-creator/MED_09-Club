    <diagram id="JYIqsDQJIxRVS2ucVzxN" name="CLASS DIAGRAM">
        <mxGraphModel dx="3016" dy="-248" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam shadowing false\nskinparam backgroundColor white\nskinparam defaultFontName Arial\nskinparam defaultFontSize 12\nskinparam ClassBorderThickness 1.5\nskinparam ArrowThickness 1.2\nskinparam classAttributeIconSize 0\nskinparam linetype ortho\nhide methods\n\nclass ThanhVien {\n  id : UUID\n  ho_ten : String\n  email : String\n  so_dien_thoai : String\n  mat_khau_hash : String\n  vai_tro : VaiTro\n  trang_thai : TrangThaiTaiKhoan\n  ngay_tham_gia : Date\n  ngay_cap_nhat : DateTime\n}\n\nclass SuKien {\n  id : UUID\n  ten : String\n  mo_ta : String\n  dia_diem : String\n  thoi_gian_bat_dau : DateTime\n  thoi_gian_ket_thuc : DateTime\n  ngay_tao : DateTime\n}\n\nclass SuKienThanhVien {\n  id : UUID\n  trang_thai : TrangThaiThamDu\n  ngay_dang_ky : DateTime\n  thoi_gian_diem_danh : DateTime\n}\n\nclass DeXuatChi {\n  id : UUID\n  tieu_de : String\n  noi_dung : String\n  kinh_phi : Decimal\n  trang_thai : TrangThaiDeXuat\n  ngay_tao : DateTime\n  ngay_xu_ly : DateTime\n  ghi_chu_xu_ly : String\n}\n\nclass BieuQuyet {\n  id : UUID\n  ket_qua : KetQuaBieuQuyet\n  ngay_bieu_quyet : DateTime\n  ghi_chu : String\n}\n\nclass GiaoDichQuy {\n  id : UUID\n  loai : LoaiGiaoDich\n  so_tien : Decimal\n  noi_dung : String\n  ngay_giao_dich : DateTime\n  ngay_cap_nhat : DateTime\n}\n\nclass ChungTu {\n  id : UUID\n  ten_tep : String\n  loai_tep : String\n  kich_thuoc : Long\n  ngay_tai_len : DateTime\n  object_key : String\n}\n\n&#39; Cấu trúc ẩn giúp định vị các block class không bị chạy lung tung, giữ bố cục thẳng thớm\nThanhVien -[hidden]right-&gt; SuKien\nSuKien -[hidden]right-&gt; DeXuatChi\nDeXuatChi -[hidden]down-&gt; BieuQuyet\nBieuQuyet -[hidden]right-&gt; GiaoDichQuy\nGiaoDichQuy -[hidden]right-&gt; SuKienThanhVien\nSuKienThanhVien -[hidden]right-&gt; ChungTu\n\n&#39; Các mối quan hệ chuẩn hóa khớp 100% với ảnh sơ đồ\nThanhVien \&quot;1\&quot; -- \&quot;*\&quot; DeXuatChi : tạo &gt;\nThanhVien \&quot;1\&quot; ..&gt; \&quot;0..*\&quot; DeXuatChi : xử lý &gt;\nThanhVien \&quot;1\&quot; -- \&quot;*\&quot; BieuQuyet : bỏ phiếu &gt;\nThanhVien \&quot;1\&quot; -- \&quot;*\&quot; GiaoDichQuy : thực hiện / cập nhật &gt;\nThanhVien \&quot;1\&quot; -- \&quot;*\&quot; SuKien : phụ trách &gt;\nThanhVien \&quot;1\&quot; --&gt; \&quot;*\&quot; SuKienThanhVien : đăng ký &gt;\nThanhVien \&quot;1\&quot; -- \&quot;*\&quot; ChungTu : tải lên &gt;\n\nSuKien \&quot;1\&quot; *-- \&quot;*\&quot; SuKienThanhVien : có &gt;\n\nDeXuatChi \&quot;1\&quot; *-- \&quot;*\&quot; BieuQuyet : có &gt;\nDeXuatChi \&quot;1\&quot; --&gt; \&quot;0..1\&quot; GiaoDichQuy : phát sinh CHI &gt;\n\nGiaoDichQuy \&quot;0..1\&quot; --&gt; \&quot;*\&quot; GiaoDichQuy : điều chỉnh (giao dịch bù) &gt;\nGiaoDichQuy \&quot;1\&quot; --&gt; \&quot;*\&quot; ChungTu : đính kèm &gt;\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="14rBl5NQqleLxQ87_on2-1">
