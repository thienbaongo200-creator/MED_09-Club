                <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Activity Diagram - UC10 Duyet / Tu choi de xuat chi\n\nskinparam ActivityBackgroundColor #F9F9F9\nskinparam ActivityBorderColor #333333\n\n|Thu quy / Admin|\nstart\n:Chon de xuat PENDING;\n\nif (Phe duyet hay Tu choi?) then (Tu choi)\n\n    |He thong|\n    :Mo transaction;\n    :Khoa dong de xuat;\n    :Kiem tra con PENDING?;\n\n    if (Con PENDING?) then (Khong)\n        :ROLLBACK;\n        :Thong bao de xuat\\n da duoc xu ly;\n        stop\n    else (Co)\n        :Cap nhat REJECTED;\n        :COMMIT;\n        :Thong bao tu choi thanh cong;\n        stop\n    endif\n\nelse (Phe duyet)\n\n    |He thong|\n    :Kiem tra quyen\\nTHU_QUY / ADMIN;\n    :Dem phieu AGREE / DISAGREE;\n\n    if (AGREE &gt; DISAGREE?) then (Khong)\n\n        :Thong bao khong du dieu kien;\n        :Giu trang thai PENDING;\n        stop\n\n    else (Co)\n\n        :Mo transaction;\n        :Khoa dong de xuat;\n        :Kiem tra lai PENDING;\n\n        if (Con PENDING?) then (Khong)\n\n            :ROLLBACK;\n            :Thong bao de xuat\\n da duoc xu ly;\n            stop\n\n        else (Co)\n\n            :Kiem tra nguoi duyet\\nkhac nguoi tao;\n\n            if (Tu duyet?) then (Co)\n\n                :ROLLBACK;\n                :Thong bao khong duoc tu duyet;\n                stop\n\n            else (Khong)\n\n                :Khoa quy;\n                :Kiem tra so du;\n\n                if (Du so du?) then (Khong)\n\n                    :ROLLBACK;\n                    :Thong bao quy khong du;\n                    :Giu PENDING;\n                    stop\n\n                else (Co)\n\n                    :Tao giao dich CHI;\n                    :Cap nhat APPROVED;\n\n                    if (Luu thanh cong?) then (Khong)\n\n                        :ROLLBACK;\n                        :Bao loi he thong;\n                        :Giu PENDING;\n                        stop\n\n                    else (Co)\n\n                        :COMMIT;\n                        :Thong bao duyet thanh cong;\n                        stop\n\n                    endif\n\n                endif\n\n            endif\n\n        endif\n\n    endif\n\nendif\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="2rHaflfdvU0DZNSoaNlD-1">
                    <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
