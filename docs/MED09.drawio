    <diagram id="pzsvRJmov2WM-gDsvUuc" name="Trang-21">
        <mxGraphModel dx="2258" dy="1709" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome false\nskinparam shadowing false\nskinparam backgroundColor white\nskinparam defaultFontName Arial\nskinparam defaultFontSize 11\nskinparam ClassBorderThickness 1.5\nskinparam ArrowThickness 1.2\nskinparam classAttributeIconSize 0\nleft to right direction\n\n&#39; --- ĐỊNH NGHĨA MÀU SẮC THEO TỪNG TẦNG ---\nskinparam class {\n  BackgroundColor&lt;&lt;Boundary&gt;&gt; #D0E1FD\n  BackgroundColor&lt;&lt;Controller&gt;&gt; #D5E8D4\n  BackgroundColor&lt;&lt;Guard&gt;&gt; #FFF2CC\n  BackgroundColor&lt;&lt;Service&gt;&gt; #FFFFFF\n  BackgroundColor&lt;&lt;Infrastructure&gt;&gt; #F8CECC\n  BackgroundColor&lt;&lt;Policy&gt;&gt; #E1D5E7\n  BackgroundColor&lt;&lt;DTO&gt;&gt; #E1D5E7\n  BackgroundColor&lt;&lt;Repository&gt;&gt; #FFFFFF\n  BackgroundColor&lt;&lt;Entity&gt;&gt; #FFF2CC\n}\n\n&#39; --- BOUNDARY ---\nclass \&quot;Next.js Pages (Frm*)\&quot; as Boundary &lt;&lt;Boundary&gt;&gt; {\n  FrmLogin, FrmQuanLyQuy,\n  FrmDeXuatVaBieuQuyet,\n  FrmDuyetDeXuat, FrmSuKien,\n  FrmDangKySuKien, FrmDiemDanh,\n  FrmThanhVien, FrmPhanQuyen,\n  FrmBaoCao\n}\n\n&#39; --- CONTROLLER &amp; GUARD ---\nclass Controllers &lt;&lt;Controller&gt;&gt; {\n  MemberController:\n  Login(), GetProfile(), Add(),\n  Update(), ChangeStatus(), AssignRole()\n  EventController:\n  Create(), Register(), Attendance()\n  FundController: GetStatement(),\n  AddTransaction(),\n  UpdateTransaction(), UploadVoucher()\n  ProposalController: Create(),\n  Vote(), Approve(), Reject()\n  ReportController:\n  GetFundReport(),\n  GetAttendanceReport()\n}\n\nclass RolesGuard &lt;&lt;Guard&gt;&gt; {\n  CanActivate(roles)\n}\n\n&#39; --- SERVICES ---\nclass MemberService &lt;&lt;Service&gt;&gt; {\n  Login(), GetProfile(userId),\n  AddMember(), UpdateMember(),\n  ChangeStatus(), AssignRole()\n}\n\nclass EventService &lt;&lt;Service&gt;&gt; {\n  CreateEvent(), Register(),\n  Attendance()\n}\n\nclass ReportService &lt;&lt;Service&gt;&gt; {\n  GetFundReport(),\n  GetAttendanceReport()\n}\n\nclass ProposalService &lt;&lt;Service&gt;&gt; {\n  CreateProposal(), Vote(),\n  Approve(), Reject()\n}\n\nclass FundService &lt;&lt;Service&gt;&gt; {\n  AddTransaction(),\n  UpdateTransaction(),\n  GetStatement(), GetBalance(),\n  CheckBalance(), AttachVoucher()\n}\n\n&#39; --- INFRASTRUCTURE, POLICY &amp; DTO ---\nclass TransactionManager &lt;&lt;Infrastructure&gt;&gt; {\n  Run(work): BEGIN / COMMIT /\n  ROLLBACK\n}\n\nclass StorageService &lt;&lt;Infrastructure&gt;&gt; {\n  Upload(), GetSignedUrl()\n}\n\nclass SearchService &lt;&lt;Infrastructure&gt;&gt; {\n  Index(maskedDoc),\n  Query(keyword)\n}\n\nclass MaskingPolicy &lt;&lt;Policy&gt;&gt; {\n  MaskPhone(), MaskEmail(),\n  MaskFreeText()\n}\n\nclass PublicStatementDto &lt;&lt;DTO&gt;&gt; {\n  ngayGiaoDich, loai, soTien,\n  noiDung, nguoiThucHien,\n  lienHeDaMask\n}\n\n&#39; --- REPOSITORIES ---\nclass MemberRepository &lt;&lt;Repository&gt;&gt; {\n  Get(), GetProfile(userId),\n  Insert(), Update(), SetStatus()\n}\n\nclass EventRepository &lt;&lt;Repository&gt;&gt; {\n  GetEvent(), GetRegistration(),\n  InsertRegistration(),\n  UpdateAttendance()\n}\n\nclass ProposalRepository &lt;&lt;Repository&gt;&gt; {\n  GetById(), GetForUpdate(),\n  GetPending(), UpdateStatus()\n}\n\nclass VoteRepository &lt;&lt;Repository&gt;&gt; {\n  Exists(), Insert(),\n  CountByKetQua()\n}\n\nclass FundRepository &lt;&lt;Repository&gt;&gt; {\n  GetTransactions(), Insert(),\n  Update(), GetBalance(),\n  LockFund()\n}\n\nclass VoucherRepository &lt;&lt;Repository&gt;&gt; {\n  Insert(), GetById(),\n  GetByTransaction()\n}\n\n&#39; --- ENTITIES ---\nclass ThanhVien &lt;&lt;Entity&gt;&gt; {\n  IsActive(), CanAssignRole()\n}\n\nclass \&quot;SuKien / SuKienThanhVien\&quot; as SuKienGroup &lt;&lt;Entity&gt;&gt; {\n  HasStarted(), HasEnded(),\n  IsTimeValid(),\n  MarkAttendance(trangThai)\n}\n\nclass DeXuatChi &lt;&lt;Entity&gt;&gt; {\n  IsPending(),\n  CanApprove(agree, disagree,\n  soDu, nguoiDuyet),\n  Approve(userId),\n  Reject(userId, ghiChu)\n}\n\nclass \&quot;GiaoDichQuy / BieuQuyet\&quot; as GiaoDichGroup &lt;&lt;Entity&gt;&gt; {\n  IsFromProposal(),\n  IsAmountValid(),\n  BieuQuyet: 1 phiếu /\n  (đề xuất, thành viên)\n}\n\nclass ChungTu &lt;&lt;Entity&gt;&gt; {\n  IsAllowedType(),\n  IsSizeValid()\n}\n\n&#39; --- KẾT NỐI PHÂN TẦNG ---\nBoundary --&gt; Controllers\nControllers --&gt; RolesGuard\nRolesGuard --&gt; Controllers\n\nControllers ..&gt; MemberService\nControllers ..&gt; EventService\nControllers ..&gt; ReportService\nControllers ..&gt; ProposalService\nControllers ..&gt; FundService\n\nMemberService ..&gt; MemberRepository\nMemberService ..&gt; TransactionManager\n\nEventService ..&gt; EventRepository\nEventService ..&gt; TransactionManager\n\nReportService ..&gt; FundRepository\nReportService ..&gt; EventRepository\n\nProposalService ..&gt; ProposalRepository\nProposalService ..&gt; VoteRepository\nProposalService ..&gt; FundRepository\nProposalService ..&gt; TransactionManager\n\nFundService ..&gt; FundRepository\nFundService ..&gt; VoucherRepository\nFundService ..&gt; StorageService\nFundService ..&gt; SearchService\nFundService ..&gt; MaskingPolicy\nFundService ..&gt; PublicStatementDto\nFundService ..&gt; TransactionManager\n\nMemberRepository ..&gt; ThanhVien\nEventRepository ..&gt; SuKienGroup\nProposalRepository ..&gt; DeXuatChi\nVoteRepository ..&gt; GiaoDichGroup\nFundRepository ..&gt; GiaoDichGroup\nVoucherRepository ..&gt; ChungTu\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="EEXIlkPzlVJXpAAG30RN-243">
                    <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
                        <mxGeometry as="geometry"/>
                    </mxCell>
                </UserObject>
