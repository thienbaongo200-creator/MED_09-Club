                <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\n\nactor \&quot;Người dùng\&quot; as User\nparticipant \&quot;ReportsPage\&quot; as ReportsPage\nparticipant \&quot;RolesGuard\&quot; as RolesGuard\nparticipant \&quot;ReportsController\&quot; as ReportsController\nparticipant \&quot;ReportsService\&quot; as ReportsService\nparticipant \&quot;PostgreSQL\&quot; as PostgreSQL\n\nUser -&gt; ReportsPage: Chọn loại báo cáo và\\nkroảng thời gian\n\nalt Báo cáo quỹ\n    ReportsPage -&gt; RolesGuard: GET /api/reports/fund (JWT)\n    RolesGuard -&gt; ReportsController: Cho phép mọi vai trò\nelse Báo cáo tham dự\n    ReportsPage -&gt; RolesGuard: GET\\n/api/reports/events/:id/attenda-\\nnce (JWT)\n    \n    break THANH_VIEN\n        RolesGuard --&gt; ReportsPage: 403 Forbidden\n    end\n    \n    RolesGuard -&gt; ReportsController: Chỉ THU_QUY, ADMIN\nend\n\nReportsController -&gt; ReportsService: tổng hợp báo cáo (khoảng\\nthời gian)\n\nbreak đếnNgày nhỏ hơn từ ngày\n    ReportsService --&gt; ReportsPage: 400 Bad Request\nend\n\nalt Báo cáo quỹ\n    ReportsService -&gt; PostgreSQL: SELECT SUM theo loại\\nTHU, CHI và số dư đầu kỳ,\\ncuối kỳ\n    PostgreSQL --&gt; ReportsService: số liệu tổng hợp quỹ\nelse Báo cáo tham dự\n    ReportsService -&gt; PostgreSQL: SELECT COUNT số đăng\\nký, ATTENDED, ABSENT\\n(GROUP BY)\n    PostgreSQL --&gt; ReportsService: số liệu tổng hợp tham dự\nend\n\nReportsService --&gt; ReportsPage: ReportDto chỉ chứa số liệu tổng hợp\nReportsPage --&gt; User: Hiển thị báo cáo\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="wLvlozRV8pZMNazjZht--536">
                    <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
                        <mxGeometry as="geometry"/>
                    </mxCell>
                </UserObject>
