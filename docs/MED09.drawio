                <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\n\nactor \&quot;THU_QUY /\\nADMIN\&quot; as User\nparticipant \&quot;EventsPage\&quot; as EventsPage\nparticipant \&quot;RolesGuard\&quot; as RolesGuard\nparticipant \&quot;EventsController\&quot; as EventsController\nparticipant \&quot;EventsService\&quot; as EventsService\nparticipant \&quot;PostgreSQL\&quot; as PostgreSQL\n\nUser -&gt; EventsPage: Nhập dữ liệu sự kiện (tạo\\nmới hoặc sửa)\nEventsPage -&gt; RolesGuard: POST /api/events hoặc\\nPATCH /api/events/:id\\n(JWT)\n\nalt không phải THU_QUY/ADMIN\n    RolesGuard --&gt; EventsPage: 403 Forbidden\nelse được phép\n    RolesGuard -&gt; EventsController: Chuyển yêu cầu (người\\nphụ trách lấy từ token)\n    EventsController -&gt; EventsService: create / update(dữ liệu,\\nuserId)\n\n    alt thiếu trường bắt buộc hoặc thời gian kết thúc không lớn hơn\\nbắt đầu\n        EventsService --&gt; EventsPage: Từ chối trước khi ghi dữ liệu\n    else hợp lệ\n        EventsService -&gt; PostgreSQL: INSERT / UPDATE\\nsu_kien (CHECK thời gian\\n- làm lớp bảo vệ thêm)\n        PostgreSQL --&gt; EventsService: bản ghi sự kiện\n        EventsService --&gt; EventsPage: Sự kiện đã lưu\n    end\nend\n\nEventsPage --&gt; User: Cập nhật danh sách sự kiện\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="wLvlozRV8pZMNazjZht--229">
