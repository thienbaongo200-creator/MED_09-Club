                <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\n\nactor \&quot;THU_QUY /\\nADMIN\&quot; as User\nparticipant \&quot;MembersPage\&quot; as MembersPage\nparticipant \&quot;RolesGuard\&quot; as RolesGuard\nparticipant \&quot;MembersController\&quot; as MembersController\nparticipant \&quot;MembersService\&quot; as MembersService\nparticipant \&quot;PostgreSQL\&quot; as PostgreSQL\n\nUser -&gt; MembersPage: Mở danh sách thành viên\nMembersPage -&gt; RolesGuard: GET /api/members (JWT)\nRolesGuard -&gt; MembersController: Chỉ cho ADMIN,\\nTHU_QUY\nMembersController -&gt; MembersService: list()\nMembersService -&gt; PostgreSQL: SELECT thanh_vien\nPostgreSQL --&gt; MembersService: danh sách\nMembersService --&gt; MembersPage: Danh sách thành viên\n\nUser -&gt; MembersPage: Thêm / sửa hồ sơ /\\nkhóa-mở khóa\nMembersPage -&gt; RolesGuard: POST /api/members,\\nPATCH /api/members/:id\\nhoặc PATCH\\n/api/members/:id/status\n\nalt người gọi không phải ADMIN/THU_QUY\n    RolesGuard --&gt; MembersPage: 403 Forbidden\nelse được phép\n    RolesGuard -&gt; MembersController: Chuyển yêu cầu (actorId\\nlấy từ token)\n    MembersController -&gt; MembersService: create / update /\\nsetStatus(id, dữ liệu,\\nactorId)\n    MembersService -&gt; PostgreSQL: SELECT thành viên mục\\ntiêu\n    PostgreSQL --&gt; MembersService: bản ghi\n\n    alt THU_QUY thao tác trên tài khoản ADMIN\n        MembersService --&gt; MembersPage: 403 từ chối (BR05)\n    else email trùng hoặc dữ liệu không hợp lệ\n        MembersService --&gt; MembersPage: Từ chối, yêu cầu chỉnh sửa\n    else khóa hoặc hạ quyền ADMIN\n        alt làm mất ADMIN ACTIVE cuối cùng\n            MembersService -&gt; PostgreSQL: BEGIN, khóa quản trị\\n(pg_advisory_xact_lock),\\nđếm ADMIN ACTIVE\n            PostgreSQL --&gt; MembersService: \n            MembersService -&gt; PostgreSQL: ROLLBACK\n            PostgreSQL --&gt; MembersService: \n            MembersService --&gt; MembersPage: Từ chối (BR05)\n        else hợp lệ\n            MembersService -&gt; PostgreSQL: INSERT / UPDATE\\nthanh_vien (ghi\\nnguoi_cap_nhat_id,\\nngay_cap_nhat)\n            PostgreSQL --&gt; MembersService: \n            MembersService --&gt; MembersPage: Kết quả\n        end\n    end\nend\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="wLvlozRV8pZMNazjZht--82">
                    <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
                        <mxGeometry as="geometry"/>
                    </mxCell>
                </UserObject>
