                <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\n\nactor \&quot;ADMIN\&quot; as User\nparticipant \&quot;MembersPage\&quot; as MembersPage\nparticipant \&quot;RolesGuard\&quot; as RolesGuard\nparticipant \&quot;MembersControlle-\\nr\&quot; as MembersController\nparticipant \&quot;MembersService\&quot; as MembersService\nparticipant \&quot;PostgreSQL\&quot; as PostgreSQL\n\nUser -&gt; MembersPage: Chọn vai trò mới trong\\nbảng thành viên\nMembersPage -&gt; RolesGuard: PATCH\\n/api/members/:id/role (JWT)\n\nbreak người gọi không\\nphải ADMIN (kể\\ncả THU_QUY)\n    RolesGuard --&gt; MembersPage: 403 Forbidden, không đổi\\ndữ liệu\nend\n\nRolesGuard -&gt; MembersController: Chuyển yêu cầu (actorId từ\\ntoken)\nMembersController -&gt; MembersService: updateRole(id, vaiTro,\\nactorId)\nMembersService -&gt; PostgreSQL: BEGIN\nMembersService -&gt; PostgreSQL: pg_advisory_xact_lock (khóa\\nquản trị)\nMembersService -&gt; PostgreSQL: SELECT COUNT(*)\\nADMIN ACTIVE\nPostgreSQL --&gt; MembersService: số ADMIN ACTIVE\n\nalt thao tác làm mất ADMIN ACTIVE cuối cùng\n    MembersService -&gt; PostgreSQL: ROLLBACK\n    PostgreSQL --&gt; MembersService: \n    MembersService --&gt; MembersPage: Từ chối (BR05)\nelse vẫn còn ít nhất một ADMIN ACTIVE\n    MembersService -&gt; PostgreSQL: UPDATE thanh_vien SET\\nvai_tro (nguoi_cap_nhat_id,\\nngay_cap_nhat)\n    PostgreSQL --&gt; MembersService: \n    MembersService -&gt; PostgreSQL: COMMIT\n    PostgreSQL --&gt; MembersService: \n    MembersService --&gt; MembersPage: Thành công (hiệu lực ở lần đăng nhập hoặc làm mới token tiếp theo)\nend\n\nMembersPage --&gt; User: Tải lại danh sách thành\\nviên\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="wLvlozRV8pZMNazjZht--501">
                    <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
                        <mxGeometry as="geometry"/>
                    </mxCell>
                </UserObject>
