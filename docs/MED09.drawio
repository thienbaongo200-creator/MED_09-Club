                <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\n\nactor \&quot;Người dùng\&quot; as User\nparticipant \&quot;ProfilePage\&quot; as ProfilePage\nparticipant \&quot;RolesGuard\&quot; as RolesGuard\nparticipant \&quot;AuthController\&quot; as AuthController\nparticipant \&quot;AuthService\&quot; as AuthService\nparticipant \&quot;PostgreSQL\&quot; as PostgreSQL\n\nUser -&gt; ProfilePage: Mở hồ sơ cá nhân\nProfilePage -&gt; RolesGuard: GET /api/auth/me (kèm JWT)\n\nalt token không hợp lệ hoặc hết hạn\n    RolesGuard --&gt; ProfilePage: 401, không trả dữ liệu\nelse token hợp lệ\n    RolesGuard -&gt; AuthController: Chuyển yêu cầu (userId lấy từ token)\n    AuthController -&gt; AuthService: getProfile(userId)\n    AuthService -&gt; PostgreSQL: SELECT thanh_vien WHERE id = userId\n    PostgreSQL --&gt; AuthService: hồ sơ của chính người dùng\n    AuthService --&gt; ProfilePage: Hồ sơ (không có mat_khau_hash)\n    ProfilePage --&gt; User: Hiển thị hồ sơ\nend\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="wLvlozRV8pZMNazjZht--27">
