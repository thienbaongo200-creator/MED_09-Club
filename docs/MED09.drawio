                <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\n\nactor \&quot;Người dùng\&quot; as User\nparticipant \&quot;EventsPage\&quot; as EventsPage\nparticipant \&quot;RolesGuard\&quot; as RolesGuard\nparticipant \&quot;EventsController\&quot; as EventsController\nparticipant \&quot;EventsService\&quot; as EventsService\nparticipant \&quot;PostgreSQL\&quot; as PostgreSQL\n\nUser -&gt; EventsPage: Chọn sự kiện, nhấn Đăng\\nký\nEventsPage -&gt; RolesGuard: POST\\n/api/events/:id/register\\n(JWT)\nRolesGuard -&gt; EventsController: Cho phép mọi vai trò đã\\nđăng nhập\nEventsController -&gt; EventsService: register(suKienId, userId\\nlấy từ token)\nEventsService -&gt; PostgreSQL: SELECT su_kien WHERE id\nPostgreSQL --&gt; EventsService: sự kiện hoặc rỗng\n\nalt không tồn tại hoặc đã kết thúc\n    EventsService --&gt; EventsPage: 409 Conflict\nelse hợp lệ\n    EventsService -&gt; PostgreSQL: SELECT\\nsu_kien_thanh_vien (sự kiện,\\nthành viên)\n    PostgreSQL --&gt; EventsService: bản đăng ký hoặc rỗng\n\n    alt đã đăng ký\n        EventsService --&gt; EventsPage: 409 Conflict\n    else chưa đăng ký\n        EventsService -&gt; PostgreSQL: INSERT su_kien_thanh_vien\\n(REGISTERED), UNIQUE\\nchặn trùng khi đồng thời\n        PostgreSQL --&gt; EventsService: \n        EventsService --&gt; EventsPage: 201 Created\n    end\nend\n\nEventsPage --&gt; User: Hiển thị trạng thái đăng ký\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="wLvlozRV8pZMNazjZht--258">
                    <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
                        <mxGeometry as="geometry"/>
                    </mxCell>
