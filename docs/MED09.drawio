                <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\n\nactor \&quot;Người dùng\&quot; as User\nparticipant \&quot;ProposalVotingPag-\\ne\&quot; as ProposalVotingPage\nparticipant \&quot;RolesGuard\&quot; as RolesGuard\nparticipant \&quot;ProposalsControll-\\ner\&quot; as ProposalsController\nparticipant \&quot;ProposalsService\&quot; as ProposalsService\nparticipant \&quot;PostgreSQL\&quot; as PostgreSQL\n\nUser -&gt; ProposalVotingPage: Chọn AGREE hoặc\\nDISAGREE\nProposalVotingPage -&gt; RolesGuard: POST\\n/api/proposals/:id/vote\\n(JWT)\nRolesGuard -&gt; ProposalsController: Cho phép mọi vai trò đã\\nđăng nhập\nProposalsController -&gt; ProposalsService: vote(id, ketQua, userId lấy\\ntừ token)\nProposalsService -&gt; PostgreSQL: SELECT de_xuat_chi\\nWHERE id\nPostgreSQL --&gt; ProposalsService: đề xuất\n\nalt không còn PENDING\n    ProposalsService --&gt; ProposalVotingPage: 409 Conflict\nelse hợp lệ\n    ProposalsService -&gt; PostgreSQL: INSERT bieu_quyet\\n(de_xuat_id,\\nthanh_vien_id, ket_qua)\n    \n    alt vi phạm UNIQUE (de_xuat_id, thanh_vien_id)\n        PostgreSQL --&gt; ProposalsService: lỗi trùng khóa\n        ProposalsService --&gt; ProposalVotingPage: 409, mỗi thành viên một phiếu (BR04)\n    else ghi thành công\n        PostgreSQL --&gt; ProposalsService: phiếu đã lưu\n        ProposalsService --&gt; ProposalVotingPage: Ghi nhận phiếu\n    end\nend\n\nProposalVotingPage --&gt; User: Cập nhật số phiếu và trạng\\nthái\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="wLvlozRV8pZMNazjZht--346">
                    <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
