                <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\n\nactor \&quot;THU_QUY /\\nADMIN\&quot; as User\nparticipant \&quot;EventsPage\&quot; as EventsPage\nparticipant \&quot;RolesGuard\&quot; as RolesGuard\nparticipant \&quot;EventsController\&quot; as EventsController\nparticipant \&quot;EventsService\&quot; as EventsService\nparticipant \&quot;PostgreSQL\&quot; as PostgreSQL\n\nUser -&gt; EventsPage: Chọn thành viên, ghi\\nATTENDED hoặc\\nABSENT\nEventsPage -&gt; RolesGuard: Gửi yêu cầu tới\\n/api/events/:id/attendance\\n(JWT)\n\nbreak không phải\\nTHU_QUY/ADMIN\n    RolesGuard --&gt; EventsPage: 403 Forbidden\nend\n\nRolesGuard -&gt; EventsController: Chuyển yêu cầu (người\\nđiểm danh lấy từ token)\nEventsController -&gt; EventsService: markAttendance(suKienId,\\nthanhVienId, trangThai,\\nuserId)\nEventsService -&gt; PostgreSQL: SELECT su_kien_thanh_vien JOIN\\nsu_kien\nPostgreSQL --&gt; EventsService: bản đăng ký và thời gian sự\\nkiện\n\nalt thành viên chưa đăng ký\n    EventsService --&gt; EventsPage: Từ chối\nelse sự kiện chưa bắt đầu\n    EventsService --&gt; EventsPage: Từ chối\nelse hợp lệ (sự kiện đã kết thúc vẫn được điểm danh bổ sung)\n    EventsService -&gt; PostgreSQL: UPDATE trạng thái, thời\\ngian điểm danh, người điểm\\ndanh\n    PostgreSQL --&gt; EventsService: \n    EventsService --&gt; EventsPage: Kết quả điểm danh\nend\n\nEventsPage --&gt; User: Cập nhật danh sách\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="wLvlozRV8pZMNazjZht--291">
                    <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
                        <mxGeometry as="geometry"/>
                    </mxCell>
                </UserObject>
