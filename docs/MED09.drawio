                <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\n\nactor \&quot;THU_QUY /\\nADMIN\&quot; as User\nparticipant \&quot;FundPage\&quot; as FundPage\nparticipant \&quot;RolesGuard\&quot; as RolesGuard\nparticipant \&quot;FundsController\&quot; as FundsController\nparticipant \&quot;FundsService\&quot; as FundsService\nparticipant \&quot;ObjectStorageServ-\\nice\&quot; as ObjectStorageService\nparticipant \&quot;PostgreSQL\&quot; as PostgreSQL\n\nUser -&gt; FundPage: Nhập giao dịch, có thể đính\\nkèm chứng từ\nFundPage -&gt; RolesGuard: POST /api/fund/transactions\\n(JWT)\n\nbreak không phải\\nTHU_QUY/ADM-\\nIN\n    RolesGuard --&gt; FundPage: 403 Forbidden\nend\n\nRolesGuard -&gt; FundsController: Chuyển yêu cầu (userId từ\\ntoken)\nFundsController -&gt; FundsService: createTransaction(dữ liệu,\\ntệp, userId)\n\nbreak số tiền không lớn hơn 0\n    FundsService --&gt; FundPage: Từ chối\nend\n\nFundsService -&gt; PostgreSQL: BEGIN\nFundsService -&gt; PostgreSQL: pg_advisory_xact_lock (khóa quỹ) trước khi đọc số\\ndư\n\nopt giao dịch CHI hoặc sửa\n    FundsService -&gt; PostgreSQL: SELECT số dư toàn quỹ\n    PostgreSQL --&gt; FundsService: số dư\n\n    break số dư sau thao tác âm, hoặc sửa CHI sinh từ đề xuất\n        FundsService -&gt; PostgreSQL: ROLLBACK\n        PostgreSQL --&gt; FundsService: \n        FundsService --&gt; FundPage: 422 từ chối\n    end\nend\n\nopt có chứng từ\n    FundsService -&gt; ObjectStorageService: kiểm tra loại, dung lượng\\nrồi lưu tệp\n    ObjectStorageService --&gt; FundsService: object_key\nend\n\nFundsService -&gt; PostgreSQL: INSERT giao_dich_quy (và chung_tu nếu có chứng\\ntừ)\n\nalt lỗi khi ghi cơ sở dữ liệu\n    FundsService -&gt; PostgreSQL: ROLLBACK\n    FundsService -&gt; ObjectStorageService: cố xóa tệp vừa tải lên (xóa\\nbù, không bảo đảm)\n    ObjectStorageService --&gt; FundsService: \n    FundsService --&gt; FundPage: Lỗi\nelse thành công\n    FundsService -&gt; PostgreSQL: COMMIT\n    PostgreSQL --&gt; FundsService: \n    Database --&gt; FundsService: \n    FundsService --&gt; FundPage: Giao dịch đã lưu\nend\n\nFundPage --&gt; User: Cập nhật sao kê và số dư\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="wLvlozRV8pZMNazjZht--445">
                    <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
                        <mxGeometry as="geometry"/>
                    </mxCell>
                </UserObject>
