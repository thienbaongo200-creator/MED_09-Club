                <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\n\nactor \&quot;Người duyệt\&quot; as User\nparticipant \&quot;ProposalReviewPa-\\nge\&quot; as ProposalReviewPage\nparticipant \&quot;RolesGuard\&quot; as RolesGuard\nparticipant \&quot;ProposalsControll-\\ner\&quot; as ProposalsController\nparticipant \&quot;ProposalsService\&quot; as ProposalsService\nparticipant \&quot;PostgreSQL\&quot; as PostgreSQL\n\nUser -&gt; ProposalReviewPage: Phê duyệt hoặc Từ\\nchối\n\nalt Phê duyệt (luồng chính)\n    ProposalReviewPage -&gt; RolesGuard: POST\\n/api/proposals/:id/approve\\n(JWT)\n    \n    break vai trò không\\nphải\\nTHU_QUY/ADM-\\nIN\n        RolesGuard --&gt; ProposalReviewPage: 403 Forbidden, không đổi\\ndữ liệu\n    end\n\n    RolesGuard -&gt; ProposalsController: Chuyển yêu cầu (userId từ\\ntoken)\n    ProposalsController -&gt; ProposalsService: approve(id, userId)\n    ProposalsService -&gt; PostgreSQL: BEGIN\n    ProposalsService -&gt; PostgreSQL: SELECT de_xuat_chi\\nWHERE id FOR UPDATE\n    PostgreSQL --&gt; ProposalsService: đề xuất (trạng thái, người\\ntạo, kinh phí)\n\n    break trạng thái khác PENDING\n        ProposalsService -&gt; PostgreSQL: ROLLBACK\n        PostgreSQL --&gt; ProposalsService: \n        ProposalsService --&gt; ProposalReviewPage: 409 đề xuất đã được xử lý\n    end\n\n    break người duyệt trùng người tạo (BR07)\n        ProposalsService -&gt; PostgreSQL: ROLLBACK\n        PostgreSQL --&gt; ProposalsService: \n        ProposalsService --&gt; ProposalReviewPage: 403 không được tự duyệt\n    end\n\n    ProposalsService -&gt; PostgreSQL: SELECT ket_qua,\\nCOUNT(*) FROM\\nbieu_quyet GROUP BY\\nket_qua\n    PostgreSQL --&gt; ProposalsService: AGREE, DISAGREE\n\n    break AGREE không lớn hơn DISAGREE\n        ProposalsService -&gt; PostgreSQL: ROLLBACK\n        PostgreSQL --&gt; ProposalsService: \n        ProposalsService --&gt; ProposalReviewPage: 422 không đủ phiếu, giữ PENDING\n    end\n\n    ProposalsService -&gt; PostgreSQL: pg_advisory_xact_lock (khóa\\nquỹ)\n    ProposalsService -&gt; PostgreSQL: SELECT SUM(THU) -\\nSUM(CHI) (số dư)\n    PostgreSQL --&gt; ProposalsService: số dư\n\n    break số dư nhỏ hơn kinh phí\n        ProposalsService -&gt; PostgreSQL: ROLLBACK\n        PostgreSQL --&gt; ProposalsService: \n        ProposalsService --&gt; ProposalReviewPage: 422 quỹ không đủ, giữ PENDING\n    end\n\n    ProposalsService -&gt; PostgreSQL: INSERT giao_dich_quy\\n(CHI)\n    ProposalsService -&gt; PostgreSQL: UPDATE de_xuat_chi SET\\nAPPROVED\\n(nguoi_xu_ly_id,\\nngay_xu_ly)\n    ProposalsService -&gt; PostgreSQL: COMMIT\n    PostgreSQL --&gt; ProposalsService: \n    ProposalsService --&gt; ProposalReviewPage: 200 duyệt thành công\n\nelse Từ chối (luồng thay thế A1)\n    ProposalReviewPage -&gt; RolesGuard: POST\\n/api/proposals/:id/reject\\n(JWT)\n    RolesGuard -&gt; ProposalsController: Kiểm tra vai trò rồi chuyển\\nyêu cầu\n    ProposalsController -&gt; ProposalsService: reject(id, userId, ghiChu)\n    ProposalsService -&gt; PostgreSQL: BEGIN, SELECT\\nde_xuat_chi FOR UPDATE\n    ProposalsService -&gt; PostgreSQL: nếu còn PENDING thì\\nUPDATE SET REJECTED\n    ProposalsService -&gt; PostgreSQL: COMMIT (hoặc\\nROLLBACK nếu không còn\\nPENDING)\n    PostgreSQL --&gt; ProposalsService: \n    ProposalsService --&gt; ProposalReviewPage: 200 từ chối, không tạo CHI (409 nếu đã được xử lý)\nend\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="wLvlozRV8pZMNazjZht--378">
                    <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
                        <mxGeometry as="geometry"/>
                    </mxCell>
                </UserObject>
