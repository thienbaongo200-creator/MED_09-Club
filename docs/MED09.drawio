                <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\nskinparam backgroundColor white\nskinparam defaultFontName Arial\nskinparam defaultFontSize 12\nskinparam ClassBorderThickness 1.5\nskinparam ArrowThickness 1.5\nhide circle\nskinparam linetype ortho\n\nentity thanh_vien {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * ho_ten : VARCHAR(100)\n  * email : VARCHAR(100) &lt;&lt;UQ&gt;&gt;\n  so_dien_thoai : VARCHAR(20)\n  * mat_khau_hash : VARCHAR(255)\n  * vai_tro : VARCHAR(20)\n  * trang_thai : VARCHAR(20)\n  * ngay_tham_gia : DATE\n  ngay_cap_nhat : TIMESTAMP\n  nguoi_cap_nhat_id : UUID &lt;&lt;FK&gt;&gt;\n}\n\nentity su_kien {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * ten : VARCHAR(200)\n  mo_ta : TEXT\n  dia_diem : VARCHAR(200)\n  * thoi_gian_bat_dau : TIMESTAMP\n  * thoi_gian_ket_thuc : TIMESTAMP\n  * nguoi_phu_trach_id : UUID &lt;&lt;FK&gt;&gt;\n  * ngay_tao : TIMESTAMP\n}\n\nentity su_kien_thanh_vien {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * su_kien_id : UUID &lt;&lt;FK&gt;&gt;\n  * thanh_vien_id : UUID &lt;&lt;FK&gt;&gt;\n  * trang_thai : VARCHAR(20)\n  * ngay_dang_ky : TIMESTAMP\n  thoi_gian_diem_danh : TIMESTAMP\n  nguoi_diem_danh_id : UUID &lt;&lt;FK&gt;&gt;\n  --\n  UNIQUE (su_kien_id, thanh_vien_id)\n}\n\nentity de_xuat_chi {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * nguoi_tao_id : UUID &lt;&lt;FK&gt;&gt;\n  * tieu_de : VARCHAR(200)\n  noi_dung : TEXT\n  * kinh_phi : DECIMAL(18,2)\n  * trang_thai : VARCHAR(20)\n  * ngay_tao : TIMESTAMP\n  nguoi_xu_ly_id : UUID &lt;&lt;FK&gt;&gt;\n  ngay_xu_ly : TIMESTAMP\n  ghi_chu_xu_ly : TEXT\n}\n\nentity bieu_quyet {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * de_xuat_id : UUID &lt;&lt;FK&gt;&gt;\n  * thanh_vien_id : UUID &lt;&lt;FK&gt;&gt;\n  * ket_qua : VARCHAR(20)\n  * ngay_bieu_quyet : TIMESTAMP\n  ghi_chu : TEXT\n  --\n  UNIQUE (de_xuat_id, thanh_vien_id)\n}\n\nentity giao_dich_quy {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * loai : VARCHAR(10)\n  * so_tien : DECIMAL(18,2)\n  noi_dung : TEXT\n  * ngay_giao_dich : TIMESTAMP\n  * nguoi_thuc_hien_id : UUID &lt;&lt;FK&gt;&gt;\n  de_xuat_id : UUID &lt;&lt;FK, UQ&gt;&gt;\n  giao_dich_goc_id : UUID &lt;&lt;FK&gt;&gt;\n  ngay_cap_nhat : TIMESTAMP\n  nguoi_cap_nhat_id : UUID &lt;&lt;FK&gt;&gt;\n}\n\nentity chung_tu {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * giao_dich_id : UUID &lt;&lt;FK&gt;&gt;\n  * nguoi_tai_len_id : UUID &lt;&lt;FK&gt;&gt;\n  * ten_tep : VARCHAR(255)\n  * loai_tep : VARCHAR(100)\n  * kich_thuoc : BIGINT\n  * object_key : VARCHAR(255) &lt;&lt;UQ&gt;&gt;\n  * ngay_tai_len : TIMESTAMP\n}\n\nnote \&quot;● NOT NULL   ○ cho phép NULL\\nCác cột nguoi_*_id đều tham chiếu thanh_vien.id\\n(tạo, xử lý, phụ trách, điểm danh, cập nhật,\\nthực hiện, tải lên).\&quot; as N1\n\nthanh_vien ||--o{ su_kien : phụ trách\nthanh_vien ||--o{ su_kien_thanh_vien : đăng ký / điểm danh\nsu_kien ||--o{ su_kien_thanh_vien : có\nthanh_vien ||--o{ de_xuat_chi : tạo / xử lý\nthanh_vien ||--o{ bieu_quyet : bỏ phiếu\nde_xuat_chi ||--o{ bieu_quyet : có\nthanh_vien ||--o{ giao_dich_quy : thực hiện / cập nhật\nde_xuat_chi ||--o| giao_dich_quy : phát sinh CHI\ngiao_dich_quy ||--o{ giao_dich_quy : giao_dich_goc_id\ngiao_dich_quy ||--o{ chung_tu : đính kèm\nthanh_vien ||--o{ chung_tu : tải lên\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="iLh8ZXrt6eLCTtv21IVY-1">
